# Sen de Yaz environment. Copy to .env and fill in real values; .env is
# gitignored and read by "collage dev" and by the app itself on start. The
# shell wins over the file, and .env.development replaces .env entirely.

# Server
HOST=localhost
PORT=3000

# The address announced to the outside world: canonical URLs, Open Graph,
# sitemap. Must match what opti-image's allowedOrigins declares in
# plugins-config.json.
BASE_URL=http://localhost:3000

# Form signing keys. Generate with: openssl rand -hex 32
# Keeping them stable across restarts keeps rendered form tokens valid.
COLLAGE_CSRF_KEY=
COLLAGE_HONEYPOT_KEY=
COLLAGE_FLASH_KEY=

# Bearer token protecting /metrics; empty leaves the endpoint open.
METRICS_TOKEN=
